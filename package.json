{
  "name": "memora",
  "version": "0.1.0",
  "private": true,
  "description": "Digitizzazione locale di album fotografici su macOS",
  "author": "Damiano Mauro",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "electron:dev": "npm run dev",
    "build": "ng build && node scripts/build-electron.mjs",
    "electron:build": "npm run scanner:build && npm run build && electron-builder --mac dmg --x64",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit",
    "scanner:build": "node scripts/build-scanner.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:native-adapter": "node scripts/native-adapter-smoke.mjs",
    "test:helper": "node scripts/helper-smoke.mjs",
    "test:boundaries": "node scripts/boundary-smoke.mjs",
    "test:layout": "node scripts/layout-smoke.mjs"
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@ng-icons/core": "36.1.0",
    "@ng-icons/lucide": "36.1.0",
    "@spartan-ng/brain": "1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "luxon": "^3.7.2",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@playwright/test": "^1.63.0",
    "@spartan-ng/cli": "1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2"
  },
  "build": {
    "appId": "it.damianomauro.albumscanner",
    "productName": "Memora",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/album-scanner/browser/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": ["dmg"],
      "artifactName": "Memora-macOS-${arch}.${ext}",
      "category": "public.app-category.photography",
      "identity": null,
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Memora cerca gli scanner disponibili sulla rete locale."
      }
    },
    "extraResources": [
      {
        "from": "native/macos-scanner/.build/release/macos-scanner",
        "to": "macos-scanner"
      }
    ]
  }
}
