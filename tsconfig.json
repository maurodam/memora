{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@spartan-ng/helm/*": ["./src/app/ui/*"],
      "@spartan-ng/helm/button": ["./src/app/ui/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/app/ui/utils/src/index.ts"],
      "@spartan-ng/helm/card": ["./src/app/ui/card/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/app/ui/input/src/index.ts"],
      "@spartan-ng/helm/native-select": ["./src/app/ui/native-select/src/index.ts"],
      "@spartan-ng/helm/dialog": ["./src/app/ui/dialog/src/index.ts"],
      "@spartan-ng/helm/progress": ["./src/app/ui/progress/src/index.ts"],
      "@spartan-ng/helm/alert": ["./src/app/ui/alert/src/index.ts"],
      "@spartan-ng/helm/separator": ["./src/app/ui/separator/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  }
}
